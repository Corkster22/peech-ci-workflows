{
  "permissions": {
    "allow": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)"
    ]
  },
  "env": {
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false"
  },
  "enabledPlugins": {
    "pt-automation-hooks@peech-ci": true
  },
  "extraKnownMarketplaces": {
    "peech-ci": {
      "source": {
        "source": "github",
        "repo": "Corkster22/peech-ci-workflows"
      },
      "autoUpdate": true
    }
  }
}
